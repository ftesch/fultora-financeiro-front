<script setup lang="ts">
import { computed } from 'vue'
import { Button, Input } from '@/components/ui'
import { use{{className}}Store } from '../store'

const store = use{{className}}Store()

defineEmits(['submit'])

/**
 * Garante que sempre exista um objeto
 * para bindar no formulário
 */
const form = computed(() => {
  if (!store.item) {
    store.item = {} as any
  }

  return store.item
})
</script>

<template>
  <form class="space-y-4" @submit.prevent="$emit('submit', form)">
    {{#each fields}}
    {{#unless (eq name "id")}}
    <Input
      v-model="form.{{name}}"
      placeholder="{{name}}"
      :disabled="store.loading"
    />
    {{/unless}}
    {{/each}}

    <Button type="submit" :loading="store.loading">
      Salvar
    </Button>
  </form>
</template>
