<script setup lang='ts'>
import { Button, Table } from '@/components/ui'
import { onMounted } from 'vue'
import { use{{className}}Store } from '../store'
import { storeToRefs } from 'pinia'
import { CirclePlus, Pencil } from 'lucide-vue-next'

const { fetchData } = use{{className}}Store()
const { items, loading } = storeToRefs(useUserStore())

onMounted(async () => {
  await fetchData()
})

const columns = [
  {{#each fields}}
  {{#unless (eq name "id")}}
  {
    key: '{{name}}',
    label: '{{name}}',
  },
  {{/unless}}
  {{/each}}
]
</script>

<template>
  <PageContainer title="{{className}}" :loading="loading">
    <template #actions>
      <Button :icon="CirclePlus" variant="secondary" to="{{fullRoute}}/create" label="Novo" />
    </template>

    <Table :columns='columns' :data='items' has-actions density='compact' variant='elevated'>
      <template #actions='{ row }'>
        <Button variant='secondary' :icon="Pencil" :to='`/{{fullRoute}}/${row.id}/edit`'>
      </template>
    </Table>
  </PageContainer>
</template>